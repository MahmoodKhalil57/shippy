{
  "rules": [
    {
      "type": "Customer quotation",
      "approvers": ["kb"],
      "always": true
    },
    {
      "type": "Customer discount",
      "approvers": ["kb"],
      "always": false,
      "note": "Above the policy's max discount"
    },
    {
      "type": "Supplier PO",
      "approvers": ["kb"],
      "always": true
    },
    {
      "type": "Supplier deposit (payment)",
      "approvers": ["kb", "mh"],
      "always": true
    },
    {
      "type": "Bank detail change",
      "approvers": ["kb", "mh"],
      "twoPerson": true,
      "always": true,
      "note": "Call-back to number on file first"
    },
    {
      "type": "Exchange rate",
      "approvers": ["kb"],
      "always": true
    },
    {
      "type": "Quotation margin exception",
      "approvers": ["kb"],
      "always": true,
      "note": "Below the policy's minimum margin"
    },
    {
      "type": "Alternative product (internal)",
      "approvers": ["kb"],
      "always": true,
      "note": "Technical equivalence confirmed by a person"
    }
  ]
}
