{
  "name": "golden-sea-payload-config",
  "version": "0.0.0",
  "private": true,
  "description": "Golden Sea's Payload config: collections, globals, endpoints, widgets and seed data, built on saastemlycrm-design-system's contracts.",
  "files": [
    "src",
    "public"
  ],
  "type": "module",
  "exports": {
    ".": "./src/config.ts",
    "./seed": "./src/seed.ts",
    "./seed/branding.json": "./src/seed/globals/branding.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "qs-esm": "^8.0.2",
    "saastemlycrm-design-system": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "mock-runner": "workspace:*",
    "payload": "3.94.0",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "peerDependencies": {
    "payload": "3.94.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "download"
    }
  }
}
