{
  "name": "golden-sea-payload-config",
  "version": "0.0.0",
  "private": true,
  "description": "Golden Sea's Payload config (collections, globals, endpoints, widgets, seed) and its app: the design system's dashboard with the mock runner as its backend.",
  "files": [
    "src",
    "public"
  ],
  "type": "module",
  "exports": {
    ".": "./src/config.ts",
    "./seed": "./src/seed.ts",
    "./seed/branding.json": "./src/seed/globals/branding.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "mock:dev": "vp dev --mode mock",
    "mock:build": "tsc -p tsconfig.json && vpx build-locales.ts",
    "mock:preview": "vp preview --mode mock",
    "mock:publish": "vpx publish.ts mock",
    "check": "vp check",
    "test": "vp test",
    "cf:dev": "vp dev --mode cf.local",
    "cf:build": "tsc -p tsconfig.json && vp build --mode cf.remote",
    "cf:migrate": "wrangler d1 migrations apply golden-sea --local",
    "cf:seed": "vpx cf-seed.ts --mode cf.local",
    "cf:preview": "vp build --mode cf.local && wrangler dev -c dist/golden_sea/wrangler.json --persist-to .wrangler/state",
    "cf:migrate:remote": "wrangler d1 migrations apply golden-sea --remote",
    "cf:seed:remote": "vpx cf-seed.ts --mode cf.remote",
    "cf:deploy": "vp build --mode cf.remote && wrangler deploy",
    "cf:publish": "vpx publish.ts cf"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "cf-runner": "link:cf-runner",
    "mock-runner": "link:mock-runner",
    "qs-esm": "^8.0.2",
    "saastemlycrm-design-system": "link:saastemlycrm-design-system",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inlang/plugin-icu1": "^1.3.8",
    "@types/node": "^26.6.6",
    "payload": "3.94.0",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "wrangler": "^4.168.0"
  },
  "peerDependencies": {
    "payload": "3.94.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "download"
    }
  }
}
