{
  "name": "test-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Tests any Payload config and its seed: generated checks for the config, the seed and the backend, plus a Gherkin vocabulary for business features. Knows no project.",
  "type": "module",
  "exports": {
    "./vite": "./vite.ts",
    "./steps": "./src/steps/index.ts",
    "./backend": "./src/backend.ts",
    "./package.json": "./package.json",
    "./tours": "./src/tours/compile.ts",
    "./impact": "./src/impact/index.ts"
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test run"
  },
  "dependencies": {
    "@cucumber/gherkin": "32.2.0",
    "@cucumber/messages": "27.2.0",
    "axe-core": "4.14.1",
    "mock-runner": "link:mock-runner",
    "quickpickle": "1.11.2",
    "saastemlycrm-design-system": "link:saastemlycrm-design-system"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "payload": "3.94.0",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "peerDependencies": {
    "payload": "3.94.0",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "download"
    }
  }
}
