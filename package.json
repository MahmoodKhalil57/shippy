{
  "name": "shippy",
  "private": true,
  "workspaces": [
    "saastemlycrm-design-system",
    "golden-sea-payload-config",
    "mock-runner",
    "cf-runner"
  ],
  "scripts": {
    "mock:dev": "bun run --cwd golden-sea-payload-config mock:dev",
    "mock:build": "bun run --cwd golden-sea-payload-config mock:build",
    "cf:dev": "bun run --cwd golden-sea-payload-config cf:dev",
    "cf:deploy": "bun run --cwd golden-sea-payload-config cf:deploy"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "download"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  }
}
