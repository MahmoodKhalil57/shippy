{
  "name": "cf-runner",
  "version": "0.0.0",
  "private": true,
  "description": "A Payload-compatible full-stack runner on Cloudflare: one Worker serves a Payload config's REST API from D1 (uploads in R2) and the app's pages as static assets. The same engine as mock-runner. Knows no project and no dashboard.",
  "type": "module",
  "exports": {
    "./worker": "./src/worker.ts",
    "./store": "./src/d1-store.ts",
    "./seed": "./src/seed-sql.ts",
    "./client": "./src/client.ts",
    "./vite": "./vite.ts",
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "vp check"
  },
  "dependencies": {
    "mock-runner": "link:mock-runner"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/node": "^26.6.6",
    "payload": "3.94.0",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "wrangler": "^4.168.0"
  },
  "peerDependencies": {
    "payload": "3.94.0",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  }
}
